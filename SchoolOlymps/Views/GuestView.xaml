<UserControl x:Class="SchoolOlymps.Views.GuestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBox x:Name="SearchBox" Width="200" Margin="5"/>
            <Button x:Name="SearchBtn" Content="Найти школу" Click="SearchBtn_Click" Margin="5"/>
        </StackPanel>
        <DataGrid x:Name="SchoolsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="SchoolsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="Рейтинги выбранной школы:" Margin="5"/>
        <DataGrid x:Name="RatingsGrid" Grid.Row="3" AutoGenerateColumns="True"/>
    </Grid>
</UserControl>
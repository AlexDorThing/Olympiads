<Window x:Class="SchoolOlymps.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход/Регистрация" Height="400" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Логин" Margin="5"/>
        <TextBox x:Name="LoginBox" Grid.Row="1" Margin="5"/>

        <TextBlock Grid.Row="2" Text="Пароль" Margin="5"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" Margin="5"/>

        <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="LoginBtn" Content="Войти" Width="100" Margin="5" Click="LoginBtn_Click"/>
                <Button x:Name="RegisterBtn" Content="Регистрация" Width="100" Margin="5" Click="RegisterBtn_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="GuestBtn" Content="Войти как гость" Width="100" Margin="5" Click="GuestBtn_Click"/>
                <Button x:Name="AdminDemoBtn" Content="Войти как админ" Width="100" Margin="5" Click="AdminDemoBtn_Click"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="MessageText" Grid.Row="5" Foreground="Red" TextAlignment="Center"/>
    </Grid>
</Window>